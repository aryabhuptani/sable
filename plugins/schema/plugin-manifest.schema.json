{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sable.local/schema/plugin-manifest.schema.json",
  "title": "Sable Plugin Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "category",
    "description",
    "runtime",
    "capabilities",
    "commands",
    "requiredConfig",
    "requiredSecrets",
    "diagnostics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["descriptive", "experimental", "stable"]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array"
    },
    "requiredConfig": {
      "type": "array"
    },
    "requiredSecrets": {
      "type": "array"
    },
    "diagnostics": {
      "type": "array"
    }
  }
}
