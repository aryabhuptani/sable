{
  "name": "sable",
  "version": "1.0.0",
  "private": true,
  "description": "Sable local automation workspace.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test:smoke": "node tools/smoke/run-smoke-tests.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:doctor": "node --test tests/sable-doctor.test.js",
    "test:instance": "node --test tests/instance-config.test.js",
    "test:plugins": "node --test tests/plugin-manifest.test.js",
    "test:scheduler": "node --test tests/scheduler-cli.test.js",
    "test:kb": "node --test tests/knowledge-base-init.test.js tests/autoresearch-init.test.js",
    "test:autotweet": "node --test tests/autotweet.test.js",
    "test:homeassistant": "python3 -m unittest tests/test_homeassistant_cli.py",
    "test:humidifier": "python3 -m unittest tests/test_humidifier_low_water_signal.py",
    "test:telegram": "python3 -m unittest tests/test_telegram_cli.py",
    "test:signal-attachment": "node --test tests/test_signal_attachment_cli.js",
    "kb:init": "node tools/knowledge-base/init-topic.js",
    "kb:init-run": "node tools/knowledge-base/init-autoresearch-run.js",
    "autotweet:context": "node tools/autotweet/collect-kb-context.js",
    "autotweet:run": "node tools/autotweet/run-draft-cycle.js",
    "autotweet:suggestions": "node tools/autotweet/suggestions.js",
    "autotweet:typefully": "node tools/autotweet/typefully-cli.js",
    "autotweet:style-guide": "node tools/autotweet/bootstrap-style-guide.js",
    "ha:cli": "python3 tools/homeassistant/homeassistant_cli.py",
    "telegram:cli": "python3 tools/telegram/telegram_cli.py",
    "signal:attach": "node tools/signal/send_attachment.js",
    "sable:doctor": "node tools/doctor/sable-doctor.js"
  }
}
