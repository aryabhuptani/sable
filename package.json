{
  "name": "sable",
  "version": "1.0.0",
  "private": true,
  "description": "Sable local automation workspace.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test:smoke": "node tools/smoke/run-smoke-tests.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:doctor": "node --test tests/sable-doctor.test.js",
    "test:instance": "node --test tests/instance-config.test.js",
    "test:instance:py": "python3 -m unittest tests/test_instance_config.py",
    "test:plugins": "node --test tests/plugin-manifest.test.js tests/plugin-runtime.test.js tests/plugin-create.test.js",
    "plugin:create": "node tools/plugins/create-plugin.js",
    "test:scheduler": "node --test tests/scheduler-cli.test.js",
    "test:kb": "node --test tests/knowledge-base-init.test.js tests/autoresearch-init.test.js tests/autoresearch-archive.test.js",
    "test:memory": "node --test tests/memory-health.test.js",
    "test:autotweet": "node --test tests/autotweet.test.js",
    "test:homeassistant": "python3 -m unittest tests/test_homeassistant_plugin.py tests/test_homeassistant_cli.py",
    "test:humidifier": "python3 -m unittest tests/test_humidifier_low_water_signal.py",
    "test:telegram": "python3 -m unittest tests/test_telegram_cli.py",
    "test:whatsapp": "node --test tests/test_whatsapp_cli.js tests/whatsapp-review-plugin.test.js",
    "test:browser": "node --test tests/browser-cli.test.js tests/browser-ops-plugin.test.js",
    "test:finance": "node --test tests/gocardless-probe.test.js",
    "test:signal-attachment": "node --test tests/test_signal_attachment_cli.js",
    "test:community": "npm run shareability:check && npm run test:plugins && npm run test:doctor && node --test tests/upgrade.test.js tests/shareability-check.test.js && npm run test:smoke",
    "simulate:fresh-clone": "node tools/community/fresh-clone-sim.js",
    "kb:init": "node tools/knowledge-base/init-topic.js",
    "kb:init-run": "node tools/knowledge-base/init-autoresearch-run.js",
    "autoresearch:archive-completed": "node tools/knowledge-base/archive-completed-autoresearch-runs.js",
    "autotweet:context": "node tools/autotweet/collect-kb-context.js",
    "autotweet:run": "node tools/autotweet/run-draft-cycle.js",
    "autotweet:suggestions": "node tools/autotweet/suggestions.js",
    "autotweet:typefully": "node tools/autotweet/typefully-cli.js",
    "autotweet:style-guide": "node tools/autotweet/bootstrap-style-guide.js",
    "ha:cli": "python3 tools/homeassistant/homeassistant_cli.py",
    "telegram:cli": "python3 tools/telegram/telegram_cli.py",
    "whatsapp:cli": "node tools/whatsapp/whatsapp_cli.js",
    "browser:cli": "node tools/browser/browser_cli.js",
    "finance:gocardless": "node tools/finance/gocardless_probe.js",
    "signal:attach": "node tools/signal/send_attachment.js",
    "background-job": "node tools/background-job/background-job.js",
    "background-batch-notify": "node tools/background-job/batch-notify.js",
    "memory:health": "node tools/memory/health-check.js",
    "obsidian:ensure-serve": "node tools/obsidian-link/ensure-serve.js",
    "shareability:check": "node tools/shareability/check.js",
    "sable:doctor": "node tools/doctor/sable-doctor.js",
    "upgrade": "node tools/upgrade/upgrade.js run",
    "upgrade:check": "node tools/upgrade/upgrade.js check",
    "init:instance": "node tools/instance/init-instance.js",
    "install:user-service": "node tools/service/user-service.js install",
    "uninstall:user-service": "node tools/service/user-service.js uninstall",
    "service:restart": "node tools/service/user-service.js restart",
    "service:start": "node tools/service/user-service.js start",
    "service:status": "node tools/service/user-service.js status",
    "service:stop": "node tools/service/user-service.js stop"
  }
}
