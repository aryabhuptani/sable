# Copy to apps/signal-bridge/.env and keep the real file private.

# Signal account used by this Sable instance.
PHONE_NUMBER=+15550000000

# Signal numbers allowed to message this bridge. Comma-separated.
ALLOWED_NUMBERS=+15551112222

# Optional separate sender allowlist. If omitted, ALLOWED_NUMBERS is used.
# ALLOWED_SENDERS=+15551112222

# Private instance paths generated by `npm run init:instance`.
SABLE_INSTANCE_HOME=/home/example/sable-instance
SABLE_REPO_ROOT=/home/example/projects/sable
SABLE_CODEX_CWD=/home/example/sable-instance
SABLE_MEMORY_ROOT=/home/example/sable-instance/memory
SABLE_TASKS_ROOT=/home/example/sable-instance/memory/tasks
SABLE_KNOWLEDGE_ROOT=/home/example/sable-instance/memory/knowledge
SABLE_SKILLS_ROOT=/home/example/sable-instance/skills
SABLE_PLUGIN_PATHS=/home/example/sable-instance/plugins
CODEX_HOME=/home/example/sable-instance/.codex-bridge

# Optional attachment/runtime overrides.
# SABLE_SIGNAL_ATTACHMENT_QUEUE_DIR=/home/example/sable-instance/.local/state/sable/attachment-queue
# SABLE_SCHEDULER_JOBS_PATH=/home/example/sable-instance/memory/tasks/projects/sable/scheduler-jobs.json
# SABLE_RESEARCH_ROOT=/home/example/sable-instance/memory/knowledge/research

# Optional Telegram cleanup before bridge-side /telegram triage.
# SABLE_TELEGRAM_AUTO_CLEANUP_SOLICITATIONS=false
# SABLE_TELEGRAM_AUTO_CLEANUP_LIMIT=50

# Optional WhatsApp review integration. Only approved chats are surfaced.
# SABLE_WHATSAPP_APPROVED_CHATS_PATH=/home/example/sable-instance/.config/sable/whatsapp-approved-chats.json
# SABLE_WHATSAPP_SESSION_PATH=/home/example/sable-instance/.local/state/sable-whatsapp

# Optional browser automation state. Keep this private; it may contain cookies, downloads, screenshots, and task state.
# SABLE_BROWSER_STATE_DIR=/home/example/sable-instance/.local/state/sable-browser
# SABLE_PRIMARY_BOOKING_LINK=https://calendar.app.google/example

# Optional Sable employee instance roots.
# SABLE_EMPLOYEES_ROOT=/home/example/sable-instance/memory/agents
# SABLE_EMPLOYEE_RUNTIME_ROOT=/home/example/sable-instance/.sable/employees
# SABLE_EMPLOYEE_DOCKER_ENABLED=true
# SABLE_EMPLOYEE_DOCKER_IMAGE=node:22-bookworm

# Optional Mattermost transport for parent Sable and employee chat.
# MATTERMOST_ENABLED=false
# MATTERMOST_BASE_URL=https://mattermost.example.com
# MATTERMOST_TOKEN=example-token
# MATTERMOST_TEAM=example-team
# MATTERMOST_PARENT_CHANNEL=sable-control
# MATTERMOST_CHANNEL_ID=
# MATTERMOST_ALLOWED_USERS=
# MATTERMOST_BOT_USER_ID=
# MATTERMOST_POLL_INTERVAL_MS=5000
