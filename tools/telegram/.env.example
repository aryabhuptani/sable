# Copy to tools/telegram/.env and keep the real file private.

SABLE_TELEGRAM_API_ID=123456
SABLE_TELEGRAM_API_HASH=your_api_hash_here
SABLE_TELEGRAM_PHONE=+15551112222
SABLE_TELEGRAM_SESSION_PATH=/home/example/sable-instance/.local/state/sable-telegram/telethon.session

# Optional bridge-side cleanup before Telegram triage.
SABLE_TELEGRAM_AUTO_CLEANUP_SOLICITATIONS=false
SABLE_TELEGRAM_AUTO_CLEANUP_LIMIT=50
