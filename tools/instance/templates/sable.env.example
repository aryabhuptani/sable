# Example private instance env generated by `npm run init:instance`.
# Keep the real file outside git, usually at:
#   <instance-home>/.config/sable/sable.env

SABLE_INSTANCE_HOME=/home/example/sable-instance
SABLE_REPO_ROOT=/home/example/projects/sable
SABLE_MEMORY_ROOT=/home/example/sable-instance/memory
SABLE_KNOWLEDGE_ROOT=/home/example/sable-instance/memory/knowledge
SABLE_TASKS_ROOT=/home/example/sable-instance/memory/tasks
SABLE_SKILLS_ROOT=/home/example/sable-instance/skills
SABLE_RESEARCH_ROOT=/home/example/sable-instance/memory/knowledge/research
SABLE_AUTOTWEET_ROOT=/home/example/sable-instance/memory/knowledge/projects/sable/autotweet
SABLE_SIGNAL_BRIDGE_DIR=/home/example/projects/sable/apps/signal-bridge
SABLE_CODEX_CWD=/home/example/sable-instance
SABLE_DEFAULT_SCHEDULER_JOBS_PATH=/home/example/sable-instance/memory/tasks/projects/sable/default-scheduler-jobs.json
SABLE_SCHEDULER_JOBS_PATH=/home/example/sable-instance/memory/tasks/projects/sable/scheduler-jobs.json
SABLE_PLUGIN_PATHS=/home/example/sable-instance/plugins
CODEX_HOME=/home/example/sable-instance/.codex-bridge
